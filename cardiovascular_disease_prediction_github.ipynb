   "id": "fe8c8180",
   "metadata": {},
   "outputs": [],
   "source": [
    "rf_pipe = models[\"Random forest\"].best_estimator_\n",
    "\n",
    "perm = permutation_importance(\n",
    "    rf_pipe,\n",
    "    X_test,\n",
    "    y_test,\n",
    "    scoring=\"roc_auc\",\n",
    "    n_repeats=5,\n",
    "    random_state=RANDOM_STATE,\n",
    "    n_jobs=-1,\n",
    ")\n",
    "\n",
    "perm_df = pd.DataFrame({\n",
    "    \"variable\": X_test.columns,\n",
    "    \"importance_mean_auc\": perm.importances_mean,\n",
