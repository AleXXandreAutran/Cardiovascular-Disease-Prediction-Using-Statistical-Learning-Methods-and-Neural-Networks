   "source": [
    "## 2. Data loading\n",
    "\n",
    "The expected input file is the Kaggle cardiovascular disease dataset. By default, the notebook expects it at `data/cardiovascular_disease_dataset.csv`. The loader accepts both comma-separated and semicolon-separated versions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c9ff3482",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_dataset(path: Path) -> pd.DataFrame:\n",
    "    \"\"\"Load the cardiovascular disease dataset from a CSV file.\"\"\"\n",
    "    if not path.exists():\n",
    "        raise FileNotFoundError(\n",
    "            f\"Dataset not found at {path}. Put the CSV file in the data/ folder \"\n",
    "            \"or change DATA_PATH at the top of the notebook.\"\n",
    "        )\n",
    "\n",
    "    # sep=None lets pandas infer whether the file is comma- or semicolon-separated.\n",
    "    df = pd.read_csv(path, sep=None, engine=\"python\", decimal=\",\")\n",
    "    print(f\"File loaded: {path}\")\n",
    "    print(f\"Initial shape: {df.shape}\")\n",
    "    return df\n",
    "\n",
    "\n",
    "df_raw = load_dataset(DATA_PATH)\n",
    "df_raw.head()"
   ]
  },
